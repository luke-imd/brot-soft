# Kopieren nach .env und ausfüllen.

# Öffentliche Adresse der App (für Links in Mails: Passwort-Reset, Zahltag)
APP_URL=https://garage.example.at

# SMTP für "Passwort vergessen" und Zahltag-Mail.
# Beispiel Resend: host smtp.resend.com, port 465, user "resend", pass = API-Key
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Garage <garage@example.at>
